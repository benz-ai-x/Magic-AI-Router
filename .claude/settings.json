{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 -m py_compile*)",
      "Bash(ruff*)",
      "Bash(bash -n*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git pull *)",
      "Bash(git push*)",
      "Bash(git fetch *)",
      "Bash(gh *)",
      "Bash(lsof *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(nohup *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(sleep *)",
      "Bash(networksetup *)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)"
    ]
  }
}
