{
  "socks5_port": 1080,
  "http_listen": "127.0.0.1:8888",
  "current_tunnel": 0,
  "capture_port": 8080,
  "capture_dir": "~/.magic-proxy-captures",
  "retention_days": 7,
  "tunnels": [
    {
      "name": "示例 - Key 认证",
      "ssh_user": "ubuntu",
      "ssh_host": "your-server.com",
      "ssh_port": 22,
      "auth_type": "key",
      "ssh_key": "/Users/you/.ssh/your-key.pem",
      "ssh_compression": true
    },
    {
      "name": "示例 - 密码认证",
      "ssh_user": "root",
      "ssh_host": "192.168.1.1",
      "ssh_port": 22,
      "auth_type": "password",
      "ssh_compression": true
    }
  ]
}
