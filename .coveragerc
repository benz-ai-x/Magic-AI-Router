[run]
omit =
    # PyObjC/rumps UI — requires live NSRunLoop, untestable in CI
    app.py
    shellui/menu_builder.py
    shellui/webview_window.py
    shellui/log_window.py
    capture/ca_trust.py
    # Trivial entry points
    capture/mitmdump_entry.py
    tools/generate_icon.py
    suanpan/__main__.py
    # Test files themselves
    tests/*
